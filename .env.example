# Copy this file to `.env` (repo root or backend/) and fill in real values locally.
# `.env` is gitignored and loaded automatically by the backend. Never commit a real key.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
# Optional: whole-call Gemini request timeout (ISO-8601 duration, default PT60S).
# GEMINI_REQUEST_TIMEOUT=PT120S
